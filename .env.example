# ===== Copy this file to .env and fill it in. NEVER commit .env (it is git-ignored). =====
# Why two files: .env holds the real secrets on your machine only; .env.example is the safe template that IS committed,
# so a teammate knows which settings exist. Real values go only in .env (or in the Railway / Vercel dashboards).
#
# Every setting below is optional for local development: with an empty .env the backend uses a local SQLite file,
# a dev JWT secret and deterministic fallbacks for the LLM and voice.

# ---------------------------------------------------------------- database
# Postgres connection string from Supabase: Project Settings > Database > Connection string (URI, "Session pooler").
# Replace [YOUR-PASSWORD]. If unset, the backend falls back to local SQLite (fine for development).
DATABASE_URL=postgresql://postgres.PROJECTREF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------- security
# REQUIRED IN PRODUCTION. Long random string used to sign login tokens (and the mock ID-card QR codes).
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=480
# Comma-separated list of allowed web origins, e.g. https://coder-cup-hackathon.vercel.app (use * only for local development).
CORS_ORIGINS=*
ENV=prod

# ---------------------------------------------------------------- optional AI services (the app works without them)
# LLM: any OpenAI-compatible endpoint. Used only to word answers and break ties in voice-intent; it never decides money.
# Groq is accepted directly: set GROQ_API (and optionally GROQ_BASE_URL) instead of the three LLM_* lines.
GROQ_API=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Uplift AI: Pakistani Urdu speech-to-text and text-to-speech. Without it the app uses pre-rendered clips + the browser voice.
UPLIFT_API_KEY=your-uplift-api-key
UPLIFT_VOICE_ID=v_8eelc901
UPLIFT_BASE_URL=https://api.upliftai.org/v1

# ---------------------------------------------------------------- behaviour switches
# Seed synthetic demo data on first start (only when the database is empty).
SEED_ON_START=true
# DEMO ONLY: also return the helper one-time code in the API response. Keep false in production: the code must reach the family.
DEMO_SHOW_OTP=false
RATE_LIMIT_PER_MIN=120

# ---------------------------------------------------------------- frontend (Vite)
# API base URL used by the web app. Must include https:// in production.
VITE_API_URL=http://localhost:8000
