# ===== Copy to .env (never commit .env) =====

# Postgres connection string from Supabase: Project Settings > Database > Connection string (URI, "Session pooler").
# Replace [YOUR-PASSWORD]. If unset, the backend falls back to local SQLite (fine for development).
DATABASE_URL=postgresql://postgres.PROJECTREF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# Long random string used to sign JWTs. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

ENV=prod
CORS_ORIGINS=*

# Optional LLM (any OpenAI-compatible endpoint, e.g. OmniRoute / OpenRouter / Groq). Leave blank to run on the deterministic fallbacks.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Uplift AI (Pakistani Urdu TTS + STT). Optional: without it the app uses pre-rendered clips + the browser voice.
UPLIFT_API_KEY=
UPLIFT_VOICE_ID=v_8eelc901

# Frontend (Vite) - API base URL
VITE_API_URL=http://localhost:8000
